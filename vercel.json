{
  "version": 2,
  "buildCommand": "npm run build",
  "outputDirectory": "frontend/dist",
  "functions": {
    "api/googleReviews.py": {
      "includeFiles": "requirements.txt",
      "memory": 1024,
      "maxDuration": 10
    }
  },
  "rewrites": [
    { "source": "/api/google-reviews", "destination": "/api/googleReviews" },
    { "source": "/api/test", "destination": "/api/test.py" },
    { "source": "/api/reviews/:id", "destination": "/api/reviews.py" },
    { "source": "/api/reviews", "destination": "/api/reviews.py" },
    { "source": "/api/admin/verify", "destination": "/api/adminVerify.py" },
    { "source": "/(.*)", "destination": "/" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }
      ]
    }
  ]
} 