{
  "version": 2,
  "buildCommand": "npm run build",
  "outputDirectory": "frontend/dist",
  "rewrites": [
    { "source": "/api/test", "destination": "/api/test.py" },
    { "source": "/api/reviews/:id", "destination": "/api/deleteReview.py" },
    { "source": "/api/reviews", "destination": "/api/reviews.py" },
    { "source": "/api/admin/verify", "destination": "/api/adminVerify.py" },
    { "source": "/api/clear-reviews", "destination": "/api/clearReviews.py" },
    { "source": "/api/nuke-reviews", "destination": "/api/nukeReviews.py" },
    { "source": "/(.*)", "destination": "/" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "no-store, no-cache, must-revalidate" },
        { "key": "Pragma", "value": "no-cache" }
      ]
    },
    {
      "source": "/api/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "no-store, no-cache, must-revalidate" },
        { "key": "Pragma", "value": "no-cache" }
      ]
    }
  ]
} 